---
import { projects } from '../data/site';
---

<section id="work">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">02 /</span>
      <span class="title">Selected work</span>
      <span class="meta">{projects.length} projects · 2024–present</span>
    </div>

    <div class="rows">
      {
        projects.map((p, i) => (
          <article class="prow reveal">
            <div class="idx">{String(i + 1).padStart(2, '0')}</div>
            <div class="body">
              <h3 class="name">
                {p.name}
                <span class={`badge ${p.status}`}>{p.statusLabel}</span>
              </h3>
              <p class="desc">{p.description}</p>
              <p class="metric">{p.metric}</p>
              {p.links && (
                <p class="plinks">
                  {p.links.map((l) => (
                    <a href={l.href} target="_blank" rel="noopener">
                      {l.label} <span aria-hidden="true">↗</span>
                    </a>
                  ))}
                </p>
              )}
            </div>
            <div class="chips">
              {p.stack.map((s) => (
                <span class="chip">{s}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .rows {
    margin-top: 4px;
  }
  .prow {
    display: grid;
    grid-template-columns: 80px 1fr 230px;
    gap: clamp(20px, 3vw, 32px);
    padding: clamp(26px, 4vw, 36px) 12px;
    border-bottom: 1px solid var(--line);
    align-items: start;
    transition: background 0.25s ease;
    border-radius: 10px;
  }
  .prow:hover {
    background: var(--bg-elev);
  }
  .idx {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 30px;
    color: var(--faint);
    transition: color 0.25s ease;
    line-height: 1.1;
  }
  .prow:hover .idx {
    color: var(--accent);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(22px, 3vw, 27px);
    letter-spacing: -0.5px;
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .desc {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.62;
    margin-top: 12px;
    max-width: 62ch;
  }
  .metric {
    font-size: 14px;
    margin-top: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 14px;
  }
  .plinks a {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .plinks a:hover {
    border-color: var(--accent);
  }
  .chips {
    align-content: flex-start;
  }

  @media (max-width: 820px) {
    .prow {
      grid-template-columns: 52px 1fr;
      gap: 16px 20px;
    }
    .idx {
      font-size: 22px;
    }
    .chips {
      grid-column: 2;
      margin-top: 18px;
    }
  }
  @media (max-width: 480px) {
    .prow {
      grid-template-columns: 1fr;
    }
    .idx {
      display: none;
    }
    .chips {
      grid-column: 1;
    }
  }
</style>
