---
import { projects } from '../data/site';
---

<section id="work">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">03 /</span>
      <span class="title">Selected work</span>
      <span class="meta">{projects.length} projects · 2024–present</span>
    </div>

    <div class="cards">
      {
        projects.map((p, i) => (
          <article class="card reveal">
            <div class="top">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class={`badge ${p.status}`}>{p.statusLabel}</span>
            </div>
            <h3 class="name">{p.name}</h3>
            <p class="desc">{p.description}</p>
            <p class="metric">{p.metric}</p>
            {p.links && (
              <p class="plinks">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">
                    {l.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </p>
            )}
            <div class="chips">
              {p.stack.map((s) => (
                <span class="chip">{s}</span>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cards {
    margin-top: 22px;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(18px, 2.2vw, 26px);
  }
  /* resting state mirrors the skill chips: hairline --line border, tight
     radius, no fill, no shadow — just a larger surface */
  .card {
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 3vw, 36px);
    border: 1px solid var(--line);
    border-radius: 6px;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .card:hover {
    border-color: var(--accent);
    transform: translateY(-4px);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .idx {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--faint);
    transition: color 0.25s ease;
  }
  /* color animation on hover — the mono index picks up the accent */
  .card:hover .idx {
    color: var(--accent);
  }
  .name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.4vw, 24px);
    letter-spacing: -0.5px;
  }
  .desc {
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.6;
    margin-top: 10px;
  }
  .metric {
    font-size: 13.5px;
    margin-top: 14px;
    color: var(--ink);
    font-weight: 500;
  }
  .plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 14px;
  }
  .plinks a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }
  .plinks a:hover {
    border-color: var(--accent);
  }
  /* pin the tech stack to the bottom so cards in a row align */
  .chips {
    margin-top: auto;
    padding-top: 20px;
  }

  /* keep the 2×2 grid down to narrow widths; single column only on phones */
  @media (max-width: 520px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
