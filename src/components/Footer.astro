---
import { profile, links } from '../data/site';
const year = 2026;
---

<section id="contact" class="contact">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">04 /</span>
      <span class="title">Get in touch</span>
    </div>

    <div class="cta-block reveal">
      <h2 class="line">Let's build something<br /><span class="accent">that ships.</span></h2>
      <p class="sub">
        I'm looking for Machine Learning Engineer roles. The fastest way to reach me is email — I reply quickly.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${links.email}`}>{links.email}</a>
        <a class="btn btn-ghost" href={links.resume} target="_blank" rel="noopener">Download résumé</a>
      </div>
      <div class="social">
        <a href={links.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5A11.5 11.5 0 0 0 .5 12 11.5 11.5 0 0 0 8.4 23c.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.4 11.4 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
        </a>
        <a href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
        </a>
        <a href={links.website} target="_blank" rel="noopener" aria-label="Website">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19M12 2.5c2.6 2.6 4 6 4 9.5s-1.4 6.9-4 9.5c-2.6-2.6-4-6-4-9.5s1.4-6.9 4-9.5z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <footer class="wrap bar">
    <span>© {year} {profile.name}</span>
    <span class="mono">Built with Astro · leverai.tech</span>
  </footer>
</section>

<style>
  .contact {
    padding-bottom: 0;
  }
  .cta-block {
    padding: clamp(20px, 4vw, 36px) 0 clamp(40px, 7vw, 72px);
  }
  .line {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(38px, 7vw, 68px);
    line-height: 1.0;
    letter-spacing: -2px;
  }
  .line .accent {
    color: var(--accent);
  }
  .sub {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.55;
    max-width: 52ch;
    margin-top: 22px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 30px;
  }
  .social {
    display: flex;
    gap: 16px;
    margin-top: 34px;
  }
  .social a {
    color: var(--muted);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .social a:hover {
    color: var(--accent);
    transform: translateY(-2px);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 28px;
    padding-bottom: 36px;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 13.5px;
  }
  .bar .mono {
    font-size: 12.5px;
  }
</style>
