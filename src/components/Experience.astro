---
import { experience, education } from '../data/site';
---

<section id="experience">
  <div class="wrap">
    <div class="sec-head reveal">
      <span class="num">03 /</span>
      <span class="title">Experience</span>
    </div>

    <div class="timeline">
      {
        experience.map((job) => (
          <article class="item reveal">
            <div class="date">{job.date}</div>
            <div class="content">
              <h3 class="role">{job.role}</h3>
              <div class="org">
                {job.org}
                {job.orgMeta && <span class="orgmeta"> · {job.orgMeta}</span>}
              </div>
              <p class="summary">{job.summary}</p>
              {job.highlights && (
                <ul class="highlights">
                  {job.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="edu reveal">
      <div class="edu-label">Education</div>
      <div class="edu-grid">
        {
          education.map((e) => (
            <div class="edu-item">
              <div class="degree">{e.degree}</div>
              <div class="edu-meta">
                {e.org} · {e.meta}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .timeline {
    margin-top: 4px;
  }
  .item {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: clamp(18px, 3vw, 32px);
    padding: clamp(26px, 4vw, 34px) 0;
    border-bottom: 1px solid var(--line);
  }
  .date {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
    padding-top: 6px;
  }
  .role {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(19px, 2.4vw, 22px);
    letter-spacing: -0.4px;
  }
  .org {
    color: var(--ink);
    font-size: 15.5px;
    margin-top: 3px;
    font-weight: 500;
  }
  .orgmeta {
    color: var(--muted);
    font-weight: 400;
  }
  .summary {
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.62;
    margin-top: 14px;
    max-width: 70ch;
  }
  .highlights {
    margin-top: 14px;
    padding-left: 0;
    list-style: none;
    display: grid;
    gap: 9px;
    max-width: 72ch;
  }
  .highlights li {
    position: relative;
    padding-left: 22px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.55;
  }
  .highlights li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 9px;
    width: 6px;
    height: 6px;
    background: var(--accent);
    border-radius: 1px;
    transform: rotate(45deg);
  }

  .edu {
    margin-top: clamp(34px, 5vw, 48px);
  }
  .edu-label {
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 18px;
  }
  .edu-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .degree {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 18px;
  }
  .edu-meta {
    color: var(--muted);
    font-size: 14.5px;
    margin-top: 4px;
  }

  @media (max-width: 680px) {
    .item {
      grid-template-columns: 1fr;
      gap: 6px;
    }
    .date {
      padding-top: 0;
    }
    .edu-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
