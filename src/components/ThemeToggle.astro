---
// Light/dark toggle. Logic lives in Base.astro (global script binds [data-theme-toggle]).
---

<button data-theme-toggle type="button" aria-label="Toggle color theme" title="Toggle theme">
  <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2"></circle>
    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
  </svg>
  <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a6.6 6.6 0 0 0 9.8 9.8z"></path>
  </svg>
</button>

<style>
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  button:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  /* show the icon for the theme you'd switch TO */
  .moon {
    display: none;
  }
  :global(html[data-theme='light']) .moon {
    display: block;
  }
  :global(html[data-theme='light']) .sun {
    display: none;
  }
  :global(html[data-theme='dark']) .sun {
    display: block;
  }
  :global(html[data-theme='dark']) .moon {
    display: none;
  }
</style>
