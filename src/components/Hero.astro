---
import { profile, links, metrics } from '../data/site';
---

<header id="top" class="hero">
  <div class="wrap">
    <div class="grid">
      <div class="lead">
        {
          profile.available && (
            <div class="eyebrow reveal">
              <span class="dot" />
              {profile.availabilityLabel}
            </div>
          )
        }
        <h1 class="reveal">{profile.firstName}<br />{profile.lastName}</h1>
        <p class="role reveal">{profile.tagline}</p>
      </div>

      <aside class="side reveal">
        <div class="row"><span class="k">// role</span>MLE III → Founder, Lever AI</div>
        <div class="row"><span class="k">// based</span>{profile.location}</div>
        <div class="row">
          <span class="k">// links</span>
          <a href={links.github} target="_blank" rel="noopener">GitHub</a> ·
          <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        </div>
        <div class="cta">
          <a class="btn btn-primary" href="#work">View work</a>
          <a class="btn btn-ghost" href={links.resume} target="_blank" rel="noopener">Résumé</a>
        </div>
      </aside>
    </div>

    <div class="metrics reveal">
      {
        metrics.map((m) => (
          <div class="metric">
            <div class="num">
              {m.prefix}<span class="fig" data-count={m.value}>{m.value}</span>{m.suffix}
            </div>
            <div class="lbl">{m.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</header>

<style>
  .hero {
    padding-top: clamp(64px, 11vw, 104px);
    padding-bottom: clamp(40px, 7vw, 64px);
  }
  .grid {
    display: grid;
    grid-template-columns: 1.55fr 0.9fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: end;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 30px;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    position: relative;
    flex: none;
  }
  .dot::after {
    content: '';
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    animation: ping 2s ease-out infinite;
  }
  @keyframes ping {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(52px, 11vw, 104px);
    line-height: 0.92;
    letter-spacing: -2.5px;
  }
  .role {
    font-size: clamp(17px, 2.2vw, 22px);
    color: var(--muted);
    margin-top: 24px;
    max-width: 36ch;
    line-height: 1.45;
  }
  .side {
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--muted);
    padding-bottom: 6px;
  }
  .side .row {
    margin-bottom: 14px;
  }
  .side .k {
    display: block;
    color: var(--faint);
  }
  .side .row a {
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .side .row a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .cta {
    display: flex;
    gap: 12px;
    margin-top: 22px;
    font-family: var(--font-body);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(40px, 7vw, 68px);
    border-top: 1px solid var(--line);
  }
  .metric {
    padding: 26px 24px 8px 0;
    border-right: 1px solid var(--line);
  }
  .metric:last-child {
    border-right: 0;
  }
  .num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 5vw, 46px);
    line-height: 1;
    letter-spacing: -1.5px;
  }
  .num .fig {
    color: var(--accent);
  }
  .lbl {
    font-size: 13.5px;
    color: var(--muted);
    margin-top: 10px;
  }

  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .side {
      padding-top: 4px;
    }
  }
  @media (max-width: 560px) {
    .metrics {
      grid-template-columns: 1fr;
    }
    .metric {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 18px 0;
    }
    .metric:last-child {
      border-bottom: 0;
    }
  }
</style>
